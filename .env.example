# Copy this file to ".env" and fill in your values. Never commit .env.

# ---------- Server ----------
PORT=3000
HOST=127.0.0.1
# Public base URL used in e-mail links (verification, status page). Use https:// in production.
PUBLIC_URL=http://localhost:3000
# Name printed on certificates and e-mails
ORG_NAME=Your Institution Name
# Optional: path to a PNG/JPG logo printed on certificates
# ORG_LOGO=C:/path/to/logo.png
# Secret for hashing tokens/OTPs (min 32 chars). If empty, one is generated in data/secret.key.
APP_SECRET=
# Set to production to disable the development mailbox
# NODE_ENV=production
# Set to 1 only when running behind a reverse proxy (nginx, etc.)
# TRUST_PROXY=1

# ---------- E-mail (SMTP) ----------
# Leave SMTP_* empty during development: e-mails are then saved to data/outbox
# and can be read at http://localhost:3000/dev/mailbox
# Gmail example (needs an App Password: https://myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Certificate Desk <your.account@gmail.com>"

# ---------- AI e-mail drafting (Claude) ----------
# Without a key, a built-in template drafter is used instead.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---------- Legacy bulk tool (/bulk) relay ----------
# Token the bulk CSV tool sends in "Real email" mode
ADMIN_TOKEN=change-me-to-a-long-random-string
